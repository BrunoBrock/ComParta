<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
			Windows is built on Windows. Android is built anywhere else (the Linux job in CI), and on
			Windows too with -p:BuildAndroid=true and the maui-android workload (AD-1, epic 7).
		-->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows')) Or '$(BuildAndroid)' == 'true'">$(TargetFrameworks);net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ComParta.App</RootNamespace>
		<AssemblyName>ComParta</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>ComParta</ApplicationTitle>
		<ApplicationId>org.comparta.app</ApplicationId>
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- A release's version (build.ps1 -Version, from the git tag). Read from the environment, so the
		     MSIX packaging step, which builds the project again without the command line's properties,
		     gets it too. -->
		<ApplicationDisplayVersion Condition="'$(COMPARTA_VERSION)' != ''">$(COMPARTA_VERSION)</ApplicationDisplayVersion>
		<ApplicationVersion Condition="'$(COMPARTA_VERSION)' != ''">0</ApplicationVersion>
		<Version Condition="'$(COMPARTA_VERSION)' != ''">$(COMPARTA_VERSION)</Version>

	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<!-- A plain .exe in a folder: no Store package, nothing to install first. -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!-- Android 8.0, the oldest .NET MAUI 10 supports (epic 7 Notes). -->
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
		<!-- A plain APK people can install by hand; Google Play takes the bundle later (epic 7 story 11). -->
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<!-- The bridge and the engine read types by reflection; trimming only the framework keeps them whole. -->
		<TrimMode>partial</TrimMode>
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F6FEB" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F6FEB" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />
		<!-- Resources\Raw\wwwroot is the build output of src/ui (see build.ps1). -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- The licenses of the parts ComParta uses, shown in Settings, About (made by tools/ComParta.Notices). -->
		<MauiAsset Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ComParta.Core\ComParta.Core.csproj" />
		<ProjectReference Include="..\ComParta.Contracts\ComParta.Contracts.csproj" />
		<ProjectReference Include="..\ComParta.Engine.MonoTorrent\ComParta.Engine.MonoTorrent.csproj" />
		<ProjectReference Include="..\ComParta.Shell\ComParta.Shell.csproj" />
		<ProjectReference Include="..\ComParta.Storage.Sqlite\ComParta.Storage.Sqlite.csproj" />
	</ItemGroup>

</Project>
