<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows only for now; the Android target is added by the Android epic (AD-1). -->
		<TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ComParta.App</RootNamespace>
		<AssemblyName>ComParta</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>ComParta</ApplicationTitle>
		<ApplicationId>org.comparta.app</ApplicationId>
		<ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- A plain .exe in a folder: no Store package, nothing to install first. -->
		<WindowsPackageType>None</WindowsPackageType>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1F6FEB" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1F6FEB" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />
		<!-- Resources\Raw\wwwroot is the build output of src/ui (see build.ps1). -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ComParta.Core\ComParta.Core.csproj" />
		<ProjectReference Include="..\ComParta.Contracts\ComParta.Contracts.csproj" />
		<ProjectReference Include="..\ComParta.Engine.MonoTorrent\ComParta.Engine.MonoTorrent.csproj" />
		<ProjectReference Include="..\ComParta.Storage.Sqlite\ComParta.Storage.Sqlite.csproj" />
	</ItemGroup>

</Project>
