<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <AssemblyName>comparta-helper</AssemblyName>
    <RootNamespace>ComParta.Helper</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same engine as the app (AD-23), so the helper speaks exactly what ComParta speaks. -->
    <PackageReference Include="Mono.Nat" Version="3.0.4" />
    <PackageReference Include="MonoTorrent" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ComParta.Helper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="helper.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
