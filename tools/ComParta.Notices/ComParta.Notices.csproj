<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The standard text of each allowed license, written once at the end of the notices. -->
    <EmbeddedResource Include="LicenseTexts\*.txt" LogicalName="LicenseTexts.%(Filename).txt" />
  </ItemGroup>

</Project>
